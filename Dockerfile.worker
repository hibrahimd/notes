FROM node:20-alpine

RUN apk add --no-cache python3 make g++

WORKDIR /app

COPY package.json package-lock.json ./
COPY prisma ./prisma
COPY prisma.config.ts ./
RUN npm ci

COPY . .

# Create storage directory
RUN mkdir -p /data/notal-storage

ENV NODE_ENV=production

CMD ["npx", "tsx", "src/worker/index.ts"]
