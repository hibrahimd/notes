# Alpine tabanli. Debian'in ffmpeg paketi butun kodek kutuphaneleriyle
# birlikte 515 MB geliyordu; bize yalnizca aac/opus/vorbis cozumu, mono
# 16 kHz yeniden orneklemesi, libmp3lame kodlamasi ve mp4 muxer lazim
# (bkz. lib/media.ts: extractAudio ve yt-dlp --merge-output-format).
#
# yt-dlp'nin "yt-dlp_linux" ikilisi glibc icin derlenmis ve musl'da
# calismiyor; resmi musl yapisi kullaniliyor.
FROM node:20-alpine AS base

FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY prisma ./prisma
COPY prisma.config.ts ./
# Client burada uretiliyor ve prisma CLI ayni RUN icinde siliniyor. Silmek
# ancak dosyalarin olustugu katmanda yer kazandiriyor: sonraki katmanda
# yapilinca bytes onceki katmanda kaliyor, yalnizca whiteout ekleniyor.
#
# CLI (38 MB) ve studio-core (36 MB) calisma zamaninda kullanilmiyor.
# engines/fetch-engine/get-platform da oyle: proje driver adapter (PrismaPg)
# kullaniyor ve imajda hic query engine ikilisi yok.
#
# next/react/lucide/@img uretim bagimliligi ama worker'in ice aktarma
# zinciri hicbirine dokunmuyor.
RUN --mount=type=cache,id=notal-npm-alpine,target=/root/.npm \
    npm ci --omit=dev --ignore-scripts \
  && npx prisma generate \
  && rm -rf node_modules/next node_modules/@next \
            node_modules/react node_modules/react-dom \
            node_modules/lucide-react node_modules/@img \
            node_modules/prisma node_modules/@prisma/studio-core \
            node_modules/@prisma/engines node_modules/@prisma/fetch-engine \
            node_modules/@prisma/get-platform

FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production

# Kullanici once olusturuluyor: dosyalar --chown ile kopyalanabilsin.
# Sondaki "chown -R /app" node_modules'un tamamini ikinci kez yaziyordu.
RUN addgroup -S -g 1001 nodejs \
  && adduser -S -u 1001 -G nodejs worker \
  && mkdir -p /data/notal-storage \
  && chown worker:nodejs /data/notal-storage

RUN apk add --no-cache ffmpeg ca-certificates openssl \
  && apk add --no-cache --virtual .indirme curl \
  && curl -fsSL -o /usr/local/bin/yt-dlp \
     https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp_musllinux \
  && chmod a+rx /usr/local/bin/yt-dlp \
  && apk del .indirme

COPY --from=deps --chown=worker:nodejs /app/node_modules ./node_modules
COPY --chown=worker:nodejs package.json package-lock.json tsconfig.json ./
COPY --chown=worker:nodejs prisma ./prisma
COPY --chown=worker:nodejs src ./src
# Depodaki uretilmis client'in uzerine semadan uretilen guncel surum
COPY --from=deps --chown=worker:nodejs /app/src/generated ./src/generated

USER worker

CMD ["npx", "tsx", "src/worker/index.ts"]
