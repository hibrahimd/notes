# Debian tabanli: ffmpeg apt'ten geliyor ve yt-dlp'nin resmi tek dosyalik
# binary'si glibc icin derlendiginden Alpine/musl uzerinde calismiyor.
FROM node:20-bookworm-slim AS base

# Sadece uretim bagimliliklari (tsx uretim bagimliligidir: worker onunla calisir)
FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json ./
# Next.js, React ve ikon paketi uretim bagimliligi ama worker'in ice aktarma
# zinciri (34 dosya) hicbirine dokunmuyor; imajda 460 MB yer kapliyorlardi.
RUN npm ci --omit=dev --ignore-scripts \
  && rm -rf node_modules/next node_modules/@next \
            node_modules/react node_modules/react-dom \
            node_modules/lucide-react

FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production

# Kullanici once olusturuluyor: dosyalar --chown ile kopyalanabilsin.
# Onceden en sonda "chown -R /app" vardi ve node_modules'un tamamini ikinci
# kez yaziyordu — tek basina 929 MB'lik bir katman uretiyordu.
RUN groupadd --system --gid 1001 nodejs \
  && useradd --system --uid 1001 --gid nodejs worker \
  && mkdir -p /data/notal-storage \
  && chown worker:nodejs /data/notal-storage

RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg ca-certificates curl \
  && curl -fsSL -o /usr/local/bin/yt-dlp \
     https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp_linux \
  && chmod a+rx /usr/local/bin/yt-dlp \
  && apt-get purge -y curl \
  && apt-get autoremove -y \
  && rm -rf /var/lib/apt/lists/*

COPY --from=deps --chown=worker:nodejs /app/node_modules ./node_modules
COPY --chown=worker:nodejs package.json package-lock.json prisma.config.ts tsconfig.json ./
COPY --chown=worker:nodejs prisma ./prisma
COPY --chown=worker:nodejs src ./src

USER worker

# Prisma client'i guncel semadan uret
RUN npx prisma generate

CMD ["npx", "tsx", "src/worker/index.ts"]
