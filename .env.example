# Database
DATABASE_URL=postgresql://notal:your_password_here@localhost:5432/notal

# Redis
REDIS_URL=redis://localhost:6379

# Session — zorunlu, en az 32 karakter. Uretmek icin:
#   openssl rand -base64 48
SESSION_SECRET=change_this_to_a_random_string_at_least_32_chars

# Kayitli API anahtarlarinin (OpenAI, DeepL, SMTP sifresi) sifrelenmesinde
# kullanilir. Tanimlanmazsa SESSION_SECRET'ten turetilir; bu durumda
# SESSION_SECRET degistirilirse kayitli anahtarlar cozulemez.
#   openssl rand -base64 48
ENCRYPTION_KEY=change_this_to_a_different_random_string

# Storage (local path for media files)
STORAGE_PATH=/data/notal-storage

# Admin seed (used during first setup)
ADMIN_EMAIL=admin@kronomondo.org
ADMIN_PASSWORD=change_this_password

# Docker compose — postgres sifresi ve DATABASE_URL bu degeri kullanir
DB_PASSWORD=change_this_db_password
