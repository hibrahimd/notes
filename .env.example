# Database
DATABASE_URL=postgresql://notal:your_password_here@localhost:5432/notal

# Redis
REDIS_URL=redis://localhost:6379

# Session
SESSION_SECRET=change_this_to_a_random_string_at_least_32_chars

# Storage (local path for media files)
STORAGE_PATH=/data/notal-storage

# Admin seed (used during first setup)
ADMIN_EMAIL=admin@kronomondo.org
ADMIN_PASSWORD=change_this_password

# Docker compose
DB_PASSWORD=change_this_db_password
